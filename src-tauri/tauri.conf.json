{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NoPixel Live",
  "version": "0.1.0",
  "identifier": "dev.nopixellive.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NoPixel Live",
        "width": 1200,
        "height": 820,
        "minWidth": 420,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://static-cdn.jtvnw.net https://*.kick.com; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGQkFEOEVBOTY5MDgyODUKUldTRmdwQ1c2dGk2ejVYSzcwZzgwbmh3TXIrNm1EU3dZV2xsS2dzcU9jcVZqdFgwNjhYb09PTHcK",
      "endpoints": ["https://github.com/juddisjudd/nopixel-live/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
